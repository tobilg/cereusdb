# Pinned build inputs for CereusDB.
#
# Plain KEY=value lines: sourced by scripts/build.sh, loaded into $GITHUB_ENV by
# the workflows, and validated by `make check-deps`. No quotes, no expansions.
#
# Every submodule under deps/ has exactly one pin, where <NAME> is the directory
# name upper-cased with '-' replaced by '_':
#   <NAME>_TAG     upstream tag; the submodule gitlink must point at its commit
#   <NAME>_COMMIT  only for dependencies without a suitable upstream tag
#
# To bump a dependency:
#   git -C deps/geos fetch --tags && git -C deps/geos checkout 3.13.2
#   set GEOS_TAG=3.13.2 below
#   git add deps/geos deps/versions.env && make check-deps

# Toolchain (Rust is pinned in rust-toolchain.toml)
EMSDK_VERSION=6.0.8
WASM_PACK_VERSION=0.15.0
NODE_VERSION=22
# npm >= 11.5.1 is required for trusted publishing (OIDC) in the release workflow
NPM_VERSION=11.21.0

# SedonaDB and Rust crates
SEDONA_DB_TAG=apache-sedona-db-0.4.1
OBJECT_STORE_TAG=v0.12.5
GEORUST_GEOS_COMMIT=834c9f67703885079d307435bb66f24263488fd8
GEORUST_PROJ_TAG=proj-sys-v0.26.0
GEORUST_GDAL_TAG=gdal-src-v0.3.0

# C/C++ libraries
GEOS_TAG=3.13.1
PROJ_TAG=9.6.0
GDAL_TAG=v3.10.3
SQLITE_SRC_TAG=version-3.49.1
EXPAT_TAG=R_2_6_4
ZLIB_TAG=v1.3.1
# Must match the zstd version bundled by the zstd-sys crate in Cargo.lock
ZSTD_TAG=v1.5.7

# vcpkg ports for the S2 dependencies (global/full); matches the VCPKG_REF that
# apache-sedona-db uses for its own builds of this release
VCPKG_COMMIT=580d480f750618f8affeb77abbb956e6eeaee0ce
