+use std::sync::Arc;
+
+use arrow_array::builder::BinaryBuilder;
+use datafusion_common::{error::Result, DataFusionError};
+use datafusion_expr::ColumnarValue;
+use geos::{CoordSeq, CoordType, Geom, Geometry};
+use sedona_expr::{
+    item_crs::ItemCrsKernel,
+    scalar_udf::{ScalarKernelRef, SedonaScalarKernel},
+};
+use sedona_geometry::wkb_factory::WKB_MIN_PROBABLE_BYTES;
+use sedona_schema::{
+    datatypes::{SedonaType, WKB_GEOGRAPHY, WKB_GEOMETRY},
+    matchers::ArgMatcher,
+};
+
+use crate::executor::GeosExecutor;
+use crate::geos_to_wkb::write_geos_geometry;
+
+pub fn st_closest_point_impl() -> Vec<ScalarKernelRef> {
+    ItemCrsKernel::wrap_impl(vec![
+        Arc::new(STClosestPoint {
+            is_geography: false,
+        }),
+        Arc::new(STClosestPoint { is_geography: true }),
+    ])
+}
+
+#[derive(Debug)]
+struct STClosestPoint {
+    is_geography: bool,
+}
+
+impl SedonaScalarKernel for STClosestPoint {
+    fn return_type(&self, args: &[SedonaType]) -> Result<Option<SedonaType>> {
+        let matcher = if self.is_geography {
+            ArgMatcher::new(
+                vec![ArgMatcher::is_geography(), ArgMatcher::is_geography()],
+                WKB_GEOGRAPHY,
+            )
+        } else {
+            ArgMatcher::new(
+                vec![ArgMatcher::is_geometry(), ArgMatcher::is_geometry()],
+                WKB_GEOMETRY,
+            )
+        };
+
+        matcher.match_args(args)
+    }
+
+    fn invoke_batch(
+        &self,
+        arg_types: &[SedonaType],
+        args: &[ColumnarValue],
+    ) -> Result<ColumnarValue> {
+        let executor = GeosExecutor::new(arg_types, args);
+        let mut builder = BinaryBuilder::with_capacity(
+            executor.num_iterations(),
+            WKB_MIN_PROBABLE_BYTES * executor.num_iterations(),
+        );
+
+        executor.execute_wkb_wkb_void(|lhs, rhs| {
+            match (lhs, rhs) {
+                (Some(lhs), Some(rhs)) => {
+                    invoke_scalar(lhs, rhs, &mut builder)?;
+                    builder.append_value([]);
+                }
+                _ => builder.append_null(),
+            }
+
+            Ok(())
+        })?;
+
+        executor.finish(Arc::new(builder.finish()))
+    }
+}
+
+fn invoke_scalar(
+    geos_geom: &Geometry,
+    other_geos_geom: &Geometry,
+    writer: &mut impl std::io::Write,
+) -> Result<()> {
+    let geometry = if geos_geom.is_empty().map_err(to_execution_err("check if empty"))?
+        || other_geos_geom.is_empty().map_err(to_execution_err("check if empty"))?
+    {
+        Geometry::create_empty_point().map_err(to_execution_err("create empty point"))?
+    } else {
+        let coord_seq = geos_geom
+            .nearest_points(other_geos_geom)
+            .map_err(to_execution_err("calculate nearest points"))?;
+
+        let x = coord_seq.get_x(0).map_err(to_execution_err("get nearest x"))?;
+        let y = coord_seq.get_y(0).map_err(to_execution_err("get nearest y"))?;
+
+        let mut point_coord_seq =
+            CoordSeq::new(1, CoordType::XY).map_err(to_execution_err("create coordinate sequence"))?;
+        point_coord_seq
+            .set_x(0, x)
+            .map_err(to_execution_err("set nearest x"))?;
+        point_coord_seq
+            .set_y(0, y)
+            .map_err(to_execution_err("set nearest y"))?;
+
+        Geometry::create_point(point_coord_seq).map_err(to_execution_err("create point"))?
+    };
+
+    write_geos_geometry(&geometry, writer)?;
+    Ok(())
+}
+
+fn to_execution_err(context: &'static str) -> impl FnOnce(geos::Error) -> DataFusionError {
+    move |error| DataFusionError::Execution(format!("Failed to {context}: {error}"))
+}
+
+#[cfg(test)]
+mod tests {
+    use rstest::rstest;
+    use sedona_expr::scalar_udf::SedonaScalarUDF;
+    use sedona_schema::datatypes::{
+        SedonaType, WKB_GEOGRAPHY, WKB_GEOMETRY, WKB_GEOMETRY_ITEM_CRS, WKB_VIEW_GEOGRAPHY,
+        WKB_VIEW_GEOMETRY,
+    };
+    use sedona_testing::testers::ScalarUdfTester;
+
+    use super::*;
+
+    #[rstest]
+    fn udf_geometry(#[values(WKB_GEOMETRY, WKB_VIEW_GEOMETRY)] sedona_type: SedonaType) {
+        let udf = SedonaScalarUDF::from_impl("st_closestpoint", st_closest_point_impl());
+        let tester = ScalarUdfTester::new(udf.into(), vec![sedona_type.clone(), sedona_type]);
+        tester.assert_return_type(WKB_GEOMETRY);
+
+        let result = tester
+            .invoke_scalar_scalar("LINESTRING (0 0, 4 0)", "POINT (2 3)")
+            .unwrap();
+        tester.assert_scalar_result_equals(result, "POINT (2 0)");
+    }
+
+    #[rstest]
+    fn udf_geography(#[values(WKB_GEOGRAPHY, WKB_VIEW_GEOGRAPHY)] sedona_type: SedonaType) {
+        let udf = SedonaScalarUDF::from_impl("st_closestpoint", st_closest_point_impl());
+        let tester = ScalarUdfTester::new(udf.into(), vec![sedona_type.clone(), sedona_type]);
+        tester.assert_return_type(WKB_GEOGRAPHY);
+
+        let result = tester
+            .invoke_scalar_scalar("LINESTRING (0 0, 4 0)", "POINT (2 3)")
+            .unwrap();
+        tester.assert_scalar_result_equals(result, "POINT (2 0)");
+    }
+
+    #[rstest]
+    fn udf_invoke_item_crs(#[values(WKB_GEOMETRY_ITEM_CRS.clone())] sedona_type: SedonaType) {
+        let udf = SedonaScalarUDF::from_impl("st_closestpoint", st_closest_point_impl());
+        let tester = ScalarUdfTester::new(udf.into(), vec![sedona_type.clone(), sedona_type]);
+        tester.assert_return_type(WKB_GEOMETRY_ITEM_CRS.clone());
+
+        let result = tester
+            .invoke_scalar_scalar("LINESTRING (0 0, 4 0)", "POINT (2 3)")
+            .unwrap();
+        tester.assert_scalar_result_equals(result, "POINT (2 0)");
+    }
+}
